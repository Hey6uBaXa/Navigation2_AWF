<?xml version="1.0"?>
<sdf version="1.8" xmlns:xacro="http://ros.org/wiki/xacro">
  <model name='avf_15' canonical_link='base_link'>
    
    <!-- Define some commonly used intertial properties  -->
        <!-- Define robot constants -->

    <xacro:arg name="robot_name" default="robot01"/>
    <xacro:property
        name="robot_namespace"
        value="$(arg robot_name)"/>


    <xacro:property name="base_width" value="0.5"/>
    <xacro:property name="base_length" value="1.0"/>
    <xacro:property name="base_height" value="0.3"/>
    <xacro:macro name="box_inertia" params="m w h d">
      <inertial>
        <pose>0 0 0 ${pi/2} 0 ${pi/2}</pose>
        <mass>${m}</mass>
        <inertia>
          <ixx>${(m/12) * (h*h + d*d)}</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>${(m/12) * (w*w + d*d)}</iyy>
          <iyz>0.0</iyz>
          <izz>${(m/12) * (w*w + h*h)}</izz>
        </inertia>
      </inertial>
    </xacro:macro>

    <xacro:macro name="cylinder_inertia" params="m r h">
      <inertial>
        <pose>0 0 0 ${pi/2} 0 0</pose>
        <mass>${m}</mass>
        <inertia>
          <ixx>${(m/12) * (3*r*r + h*h)}</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>${(m/12) * (3*r*r + h*h)}</iyy>
          <iyz>0.0</iyz>
          <izz>${(m/2) * (r*r)}</izz>
        </inertia>
      </inertial>
    </xacro:macro>

    <!-- ==================== LINKS ==================== -->
    
    <!-- BASE_LINK -->
    <link name="base_link">
      <pose>1.004 0.15 0.0 0 0 3.1415</pose>
      <inertial>
        <pose>1.100 0.3 0.3 0 0 0</pose>
        <mass>268.18</mass>
        <inertia>
          <ixx>13.364</ixx>
          <ixy>-0.64484</ixy>
          <ixz>0.49442</ixz>
          <iyy>12.821</iyy>
          <iyz>0.62799</iyz>
          <izz>16.288</izz>
        </inertia>
      </inertial>
      <visual name="base_link_visual">
        <pose>1.004 0.20 0.0 0 0 3.1415</pose>
        <geometry>
          <mesh>
            <uri>package://avf_15/meshes/base_link.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.8 0.0 0.0 1.0</ambient>
          <diffuse>0.8 0.0 0.0 1.0</diffuse>
        </material>
      </visual>
      <collision name="base_link_collision">
        <pose>1.004 0.20 0.0 0 0 3.1415</pose>
        <geometry>
          <mesh>
            <uri>package://avf_15/meshes/base_link.STL</uri>
          </mesh>
        </geometry>
      </collision>
    </link>

    <!-- Robot Footprint -->
    <link name='base_footprint'>
      <pose relative_to="base_joint"/>
      <xacro:box_inertia m="15" w="${base_width}" d="${base_length}" h="${base_height}"/>
    </link>

    <joint name='base_joint' type='fixed'>
      <parent>base_link</parent>
      <child>base_footprint</child>
      <pose relative_to="base_link">0.0 0.2 0.0 0 0 0</pose>
    </joint>
    
    <!-- MAIN_WHEEL_ROTATE -->
    <link name="main_wheel_rotate">
      <!-- Координаты перенесены из джоинта URDF -->
      <pose>-0.247 0.206 0.26 0 1.5708 3.14159</pose>
      <inertial>
        <pose>0.085452 3.0653e-08 0.00065214 0 0 0</pose>
        <mass>2.085</mass>
        <inertia>
          <ixx>0.004952</ixx>
          <ixy>2.0148e-09</ixy>
          <ixz>-4.71e-05</ixz>
          <iyy>0.0082381</iyy>
          <iyz>7.2189e-10</iyz>
          <izz>0.010918</izz>
        </inertia>
      </inertial>
      <visual name="main_wheel_rotate_visual">
        <pose>0 0 0 0 0 3.14159</pose>
        <geometry>
          <mesh>
            <uri>package://avf_15/meshes/Main_wheel_rotate.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.568 0.596 0.623 1.0</ambient>
          <diffuse>0.568 0.596 0.623 1.0</diffuse>
        </material>
      </visual>
      <collision name="main_wheel_rotate_collision">
        <geometry>
          <mesh>
            <uri>package://avf_15/meshes/Main_wheel_rotate.STL</uri>
          </mesh>
        </geometry>
      </collision>
    </link>

    <!-- MAIN_WHEEL -->
    <link name="main_wheel">
      <!-- Относительные координаты: родитель Main_wheel_rotate + сдвиг джоинта -->
      <pose>-0.247 0.206 0.103 1.5708 0.4278 0</pose>
      <inertial>
        <pose>0 4.1633e-17 3.3219e-05 0 0 0</pose>
        <mass>2.1482</mass>
        <inertia>
          <ixx>0.0074405</ixx>
          <ixy>-4.3368e-19</ixy>
          <ixz>-9.0468e-19</ixz>
          <iyy>0.0074405</iyy>
          <iyz>1.0808e-18</iyz>
          <izz>0.013136</izz>
        </inertia>
      </inertial>
      <visual name="main_wheel_visual">
        <geometry>
          <mesh>
            <uri>package://avf_15/meshes/main_wheel.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.792 0.819 0.933 1.0</ambient>
          <diffuse>0.792 0.819 0.933 1.0</diffuse>
        </material>
      </visual>
      <collision name="main_wheel_collision">
        <geometry>
          <mesh>
            <uri>package://avf_15/meshes/main_wheel.STL</uri>
          </mesh>
        </geometry>
      </collision>
    </link>

    <!-- BALANCE_WHEEL_ROTATE -->
    <link name="balance_wheel_rotate">
      <pose>-0.248 -0.35 0.145 0 1.5708 0</pose>
      <inertial>
        <pose>0.059413 9.6102e-09 -0.0087271 0 0 0</pose>
        <mass>2.0352</mass>
        <inertia>
          <ixx>0.0044911</ixx>
          <ixy>1.4942e-09</ixy>
          <ixz>0.00011925</ixz>
          <iyy>0.0035926</iyy>
          <iyz>-1.2974e-09</iyz>
          <izz>0.0058912</izz>
        </inertia>
      </inertial>
      <visual name="balance_wheel_rotate_visual">
        <geometry>
          <mesh>
            <uri>package://avf_15/meshes/balance_wheel_rotate.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.568 0.596 0.623 1.0</ambient>
          <diffuse>0.568 0.596 0.623 1.0</diffuse>
        </material>
      </visual>
      <collision name="balance_wheel_rotate_collision">
        <geometry>
          <mesh>
            <uri>package://avf_15/meshes/balance_wheel_rotate.STL</uri>
          </mesh>
        </geometry>
      </collision>
    </link>

    <!-- BALANCE_WHEEL -->
    <link name="balance_wheel">
      <pose>-0.258 -0.35 0.055 -2.059 0 -1.5708</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>1.5776</mass>
        <inertia>
          <ixx>0.0025918</ixx>
          <ixy>2.4492e-19</ixy>
          <ixz>3.3949e-19</ixz>
          <iyy>0.0016889</iyy>
          <iyz>-1.0842e-19</iyz>
          <izz>0.0016889</izz>
        </inertia>
      </inertial>
      <visual name="balance_wheel_visual">
        <geometry>
          <mesh>
            <uri>package://avf_15/meshes/balance_wheel.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.568 0.596 0.623 1.0</ambient>
          <diffuse>0.568 0.596 0.623 1.0</diffuse>
        </material>
      </visual>
      <collision name="balance_wheel_collision">
        <geometry>
          <mesh>
            <uri>package://avf_15/meshes/balance_wheel.STL</uri>
          </mesh>
        </geometry>
      </collision>
    </link>

    <!-- ==================== LEFT WHEELS ==================== -->
    <!-- ROLLER_LEFT1 (Переднее левое) -->
    <link name="roller_left1">
      <!-- Из URDF J_roller_left1: xyz="0.914 0.15 0.04" rpy="0 -0.86611 0" -->
      <pose>0.914 0.10 0.04 0 -0.86611 0</pose>
      <inertial>
        <pose>0 0.05 0 0 0 0</pose>
        <mass>1.0036</mass>
        <inertia>
          <ixx>0.00083453</ixx>
          <ixy>-2.6606e-20</ixy>
          <ixz>0</ixz>
          <iyy>0.00077387</iyy>
          <iyz>-3.5515e-20</iyz>
          <izz>0.00083453</izz>
        </inertia>
      </inertial>
      <visual name="roller_left1_visual">
        <geometry>
          <mesh>
            <uri>package://avf_15/meshes/roller_left2.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>1.0 0.937 0.137 1.0</ambient>
          <diffuse>1.0 0.937 0.137 1.0</diffuse>
        </material>
      </visual>
      <collision name="roller_left1_collision">
        <geometry>
          <mesh>
            <uri>package://avf_15/meshes/roller_left2.STL</uri>
          </mesh>
        </geometry>
      </collision>
    </link>

    <!-- ROLLER_LEFT2 (Заднее левое) -->
    <link name="roller_left2">
      <!-- Из URDF J_roller_left2: xyz="1.004 0.15 0.04" rpy="0 -0.86611 0" -->
      <pose>1.004 0.10 0.04 0 -0.86611 0</pose>
      <inertial>
        <pose>0 0.05 0 0 0 0</pose>
        <mass>1.0036</mass>
        <inertia>
          <ixx>0.00083453</ixx>
          <ixy>-2.6606e-20</ixy>
          <ixz>0</ixz>
          <iyy>0.00077387</iyy>
          <iyz>-3.5515e-20</iyz>
          <izz>0.00083453</izz>
        </inertia>
      </inertial>
      <visual name="roller_left2_visual">
        <geometry>
          <mesh>
            <uri>package://avf_15/meshes/roller_left2.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>1.0 0.937 0.137 1.0</ambient>
          <diffuse>1.0 0.937 0.137 1.0</diffuse>
        </material>
      </visual>
      <collision name="roller_left2_collision">
        <geometry>
          <mesh>
            <uri>package://avf_15/meshes/roller_left2.STL</uri>
          </mesh>
        </geometry>
      </collision>
    </link>

    <!-- ==================== RIGHT WHEELS ==================== -->
    <!-- ROLLER_RIGHT1 (Переднее правое) -->
    <link name="roller_right1">
      <!-- Из URDF J_roller_right1: xyz="0.914 -0.15 0.04" rpy="0 -1.3189 0" -->
      <pose>0.914 -0.20 0.04 0 -0.86611 0</pose>
      <inertial>
        <pose>0 -0.05 0 0 0 0</pose>
        <mass>1.0036</mass>
        <inertia>
          <ixx>0.00083453</ixx>
          <ixy>-2.6606e-20</ixy>
          <ixz>0</ixz>
          <iyy>0.00077387</iyy>
          <iyz>-3.5515e-20</iyz>
          <izz>0.00083453</izz>
        </inertia>
      </inertial>
      <visual name="roller_right1_visual">
        <geometry>
          <mesh>
            <uri>package://avf_15/meshes/roller_right1.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>1.0 0.937 0.137 1.0</ambient>
          <diffuse>1.0 0.937 0.137 1.0</diffuse>
        </material>
      </visual>
      <collision name="roller_right1_collision">
        <geometry>
          <mesh>
            <uri>package://avf_15/meshes/roller_right1.STL</uri>
          </mesh>
        </geometry>
      </collision>
    </link>

    <!-- ROLLER_RIGHT2 (Заднее правое) -->
    <link name="roller_right2">
      <!-- Из URDF J_roller_right2: xyz="1.004 -0.15 0.04" rpy="-3.1416 -1.1236 3.1416" -->
      <pose>1.004 -0.20 0.04 0 -0.86611 0</pose>
      <inertial>
        <pose>0 -0.05 0 0 0 0</pose>
        <mass>1.0036</mass>
        <inertia>
          <ixx>0.00083453</ixx>
          <ixy>-2.6606e-20</ixy>
          <ixz>0</ixz>
          <iyy>0.00077387</iyy>
          <iyz>-3.5515e-20</iyz>
          <izz>0.00083453</izz>
        </inertia>
      </inertial>
      <visual name="roller_right2_visual">
        <geometry>
          <mesh>
            <uri>package://avf_15/meshes/roller_right2.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>1.0 0.937 0.137 1.0</ambient>
          <diffuse>1.0 0.937 0.137 1.0</diffuse>
        </material>
      </visual>
      <collision name="roller_right2_collision">
        <geometry>
          <mesh>
            <uri>package://avf_15/meshes/roller_right2.STL</uri>
          </mesh>
        </geometry>
      </collision>
    </link>

     <!-- VILLAS (Виллы) -->
    <link name="main_villas">
      <!-- Из URDF J_roller_right2: xyz="1.004 -0.15 0.04" rpy="-3.1416 -1.1236 3.1416" -->
      <pose>0.2 -0.05 0.1 1.5708 0 3.14159</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>1.0036</mass>
        <inertia>
          <ixx>0.00083453</ixx>
          <ixy>-2.6606e-20</ixy>
          <ixz>0</ixz>
          <iyy>0.00077387</iyy>
          <iyz>-3.5515e-20</iyz>
          <izz>0.00083453</izz>
        </inertia>
      </inertial>
      <visual name="main_villas_visual">
        <geometry>
          <mesh>
            <uri>package://avf_15/meshes/main_villas.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>1.0 0.937 0.137 1.0</ambient>
          <diffuse>1.0 0.937 0.137 1.0</diffuse>
        </material>
      </visual>
      <collision name="main_villas_collision">
        <geometry>
          <mesh>
            <uri>package://avf_15/meshes/main_villas.STL</uri>
          </mesh>
        </geometry>
      </collision>
    </link>

    <joint name="J_main_villas" type="prismatic">
      <parent>second_villas</parent>
      <child>main_villas</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.1</lower>
          <upper>1.0</upper>
          <effort>500</effort>
          <velocity>2.2</velocity>
        </limit>
      </axis>
    </joint>

     <!-- SECOND SECTION (Вторая секция) -->
    <link name="second_villas">
      <!-- Из URDF J_roller_right2: xyz="1.004 -0.15 0.04" rpy="-3.1416 -1.1236 3.1416" -->
      <pose>0.05 -0.05 0.14 1.5708 1.5708 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>1.0036</mass>
        <inertia>
          <ixx>0.00083453</ixx>
          <ixy>-2.6606e-20</ixy>
          <ixz>0</ixz>
          <iyy>0.00077387</iyy>
          <iyz>-3.5515e-20</iyz>
          <izz>0.00083453</izz>
        </inertia>
      </inertial>
      <visual name="second_villas_visual">
        <geometry>
          <mesh>
            <uri>package://avf_15/meshes/second_section.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>1.0 0.937 0.137 1.0</ambient>
          <diffuse>1.0 0.937 0.137 1.0</diffuse>
        </material>
      </visual>
      <collision name="second_villas_collision">
        <geometry>
          <mesh>
            <uri>package://avf_15/meshes/second_section.STL</uri>
          </mesh>
        </geometry>
      </collision>
    </link>

    <joint name="J_second_villas" type="prismatic">
      <parent>base_link</parent>
      <child>second_villas</child>
      <axis>
        <xyz>-1 0 0</xyz>
        <limit>
          <lower>-0.1</lower>
          <upper>1.0</upper>
          <effort>500</effort>
          <velocity>2.2</velocity>
        </limit>
      </axis>
    </joint>
    <!-- ==================== JOINTS ==================== -->

    <joint name="J_main_wheel_rotate" type="revolute">
      <parent>base_link</parent>
      <child>main_wheel_rotate</child>
      <axis>
        <xyz>-1 0 0</xyz>
        <limit>
          <!-- <lower>-1.319</lower>
          <upper>1.806</upper> -->
          <lower>-1.806</lower>
          <upper>1.806</upper>
          <effort>500</effort> <!-- Увеличено усилие под массу погрузчика -->
          <velocity>6.0</velocity>
        </limit>
      </axis>
    </joint>

    <joint name="J_main_wheel" type="revolute">
      <parent>main_wheel_rotate</parent>
      <child>main_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-inf</lower>
          <upper>inf</upper>
          <effort>5000</effort>
        </limit>
      </axis>
    </joint>

    <joint name="J_balance_wheel_rotate" type="revolute">
      <parent>base_link</parent>
      <child>balance_wheel_rotate</child>
      <axis>
        <xyz>-1 0 0</xyz>
        <limit>
          <lower>-inf</lower>
          <upper>inf</upper>
          <effort>5000</effort>
        </limit>
      </axis>
    </joint>

    <joint name="J_balance_wheel" type="revolute">
      <parent>balance_wheel_rotate</parent>
      <child>balance_wheel</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-inf</lower>
          <upper>inf</upper>
          <effort>5000</effort>
        </limit>
      </axis>
    </joint>

    <joint name="J_roller_left1" type="revolute">
      <parent>base_link</parent>
      <child>roller_left1</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-inf</lower>
          <upper>inf</upper>
          <effort>500</effort>
        </limit>
      </axis>
    </joint>

    <joint name="J_roller_left2" type="revolute">
      <parent>base_link</parent>
      <child>roller_left2</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-inf</lower>
          <upper>inf</upper>
          <effort>500</effort>
        </limit>
      </axis>
    </joint>

    <joint name="J_roller_right1" type="revolute">
      <parent>base_link</parent>
      <child>roller_right1</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-inf</lower>
          <upper>inf</upper>
          <effort>500</effort>
        </limit>
      </axis>
    </joint>

    <joint name="J_roller_right2" type="revolute">
      <parent>base_link</parent>
      <child>roller_right2</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-inf</lower>
          <upper>inf</upper>
          <effort>500</effort>
        </limit>
      </axis>
    </joint>

    
    <joint name='imu_joint' type='fixed'>
      <parent>base_link</parent>
      <child>imu_link</child>
      <pose relative_to="base_link">0.959 0.2 0.2 0 0 0</pose>
    </joint>

    <link name='imu_link'>
      <pose relative_to="imu_joint"/>
      <visual name="imu_link_visual">
        <geometry>
          <box><size>
            0.1 0.1 0.1
          </size></box>
        </geometry>
      </visual>

      <collision name="imu_link_collision">
        <geometry>
          <box><size>
            0.1 0.1 0.1
          </size></box>
        </geometry>
      </collision>

      <xacro:box_inertia m="0.1" w="0.1" d="0.1" h="0.1"/>

      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>true</visualize>
        <topic>/${robot_namespace}/demo/imu</topic>
        <gz_frame_id>imu_link</gz_frame_id>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
                <bias_mean>0.0000075</bias_mean>
                <bias_stddev>0.0000008</bias_stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
                <bias_mean>0.0000075</bias_mean>
                <bias_stddev>0.0000008</bias_stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
                <bias_mean>0.0000075</bias_mean>
                <bias_stddev>0.0000008</bias_stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
                <bias_mean>0.1</bias_mean>
                <bias_stddev>0.001</bias_stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
                <bias_mean>0.1</bias_mean>
                <bias_stddev>0.001</bias_stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
                <bias_mean>0.1</bias_mean>
                <bias_stddev>0.001</bias_stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>


    <!-- ==================== PLUGIN ==================== -->
    <ros2_control name="AVF15System" type="system">

      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>

      <joint name="J_main_wheel">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="J_main_wheel_rotate">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

       <joint name="J_main_villas">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      
      <joint name="J_second_villas">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- <joint name="J_roller_left2">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="J_roller_left1">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="J_roller_right2">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="J_roller_right1">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="J_balance_wheel_rotate">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="J_balance_wheel">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint> -->

    </ros2_control>
    
    <plugin
        filename="gz_ros2_control-system"
        name="gz_ros2_control::GazeboSimROS2ControlPlugin">

      <parameters>$(find avf_15)/config/controllers.yaml</parameters>
      <controller_manager_name>controller_manager</controller_manager_name>
      <ros>
        <namespace>/${robot_namespace}</namespace>
        <remapping>/tf:=tf</remapping>
        <remapping>/tf_static:=tf_static</remapping>
      </ros>
    </plugin> 

    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
    
    <joint name="front_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>front_camera_link</child>
      <pose relative_to="base_link">1.076 0.2 1.56 0 0.261799 0</pose>
    </joint>

    <link name='front_camera_link'>
      <pose relative_to="front_camera_joint"/>
      <visual name="front_camera_link_visual">
        <geometry>
          <box><size>
            0.015 0.130 0.0222
          </size></box>
        </geometry>
      </visual>

      <collision name="front_camera_link_collision">
        <geometry>
          <box><size>
            0.015 0.130 0.0222
          </size></box>
        </geometry>
      </collision>

      <xacro:box_inertia m="0.035" w="0.015" d="0.130" h="0.0222"/>

      <sensor name="front_depth_camera" type="rgbd_camera">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>5.0</update_rate>
        <topic>/${robot_namespace}/front_depth_camera</topic>
        <gz_frame_id>front_camera_link</gz_frame_id>
        <camera>
          <horizontal_fov>1.047198</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>3</far>
          </clip>
        </camera>
        <baseline>0.2</baseline>
        <pointCloudCutoff>0.5</pointCloudCutoff>
        <pointCloudCutoffMax>3.0</pointCloudCutoffMax>
        <distortionK1>0</distortionK1>
        <distortionK2>0</distortionK2>
        <distortionK3>0</distortionK3>
        <distortionT1>0</distortionT1>
        <distortionT2>0</distortionT2>
        <CxPrime>0</CxPrime>
        <Cx>0</Cx>
        <Cy>0</Cy>
        <focalLength>0</focalLength>
        <hackBaseline>0</hackBaseline>
      </sensor>
    </link>


    <joint name="rear_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>rear_camera_link</child>
      <pose relative_to="base_link">-0.4 0.2 0.0 0 0 3.14</pose>
    </joint>

    <link name='rear_camera_link'>
      <pose relative_to="rear_camera_joint"/>
      <visual name="rear_camera_link_visual">
        <geometry>
          <box><size>
            0.015 0.130 0.0222
          </size></box>
        </geometry>
      </visual>

      <collision name="rear_camera_link_collision">
        <geometry>
          <box><size>
            0.015 0.130 0.0222
          </size></box>
        </geometry>
      </collision>

      <xacro:box_inertia m="0.035" w="0.015" d="0.130" h="0.0222"/>

      <sensor name="rear_depth_camera" type="rgbd_camera">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>5.0</update_rate>
        <topic>/${robot_namespace}/rear_depth_camera</topic>
        <gz_frame_id>rear_camera_link</gz_frame_id>
        <camera>
          <horizontal_fov>1.047198</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>3</far>
          </clip>
        </camera>
        <baseline>0.2</baseline>
        <pointCloudCutoff>0.5</pointCloudCutoff>
        <pointCloudCutoffMax>3.0</pointCloudCutoffMax>
        <distortionK1>0</distortionK1>
        <distortionK2>0</distortionK2>
        <distortionK3>0</distortionK3>
        <distortionT1>0</distortionT1>
        <distortionT2>0</distortionT2>
        <CxPrime>0</CxPrime>
        <Cx>0</Cx>
        <Cy>0</Cy>
        <focalLength>0</focalLength>
        <hackBaseline>0</hackBaseline>
      </sensor>
    </link>

    <!-- ==================== LIVOX MID-360 3D LIDAR ==================== -->
    <joint name="livox_joint" type="fixed">
      <parent>base_link</parent>
      <child>livox_link</child>
      <!-- Размещаем его, например, на высоте 1.75 метра по центру робота -->
      <pose relative_to="base_link">0.959 0.2 1.75 0 0 0</pose>
    </joint>

    <link name='livox_link'>
      <pose relative_to="livox_joint"/>
      <visual name="livox_link_visual">
        <geometry>
          <!-- Физическая форма Livox Mid-360 напоминает небольшой куб/цилиндр -->
          <box><size>0.065 0.065 0.060</size></box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.2 0.2 0.2 1.0</diffuse>
        </material>
      </visual>

      <collision name="livox_link_collision">
        <geometry>
          <box><size>0.065 0.065 0.060</size></box>
        </geometry>
      </collision>

      <!-- Небольшой вес самого датчика -->
      <xacro:box_inertia m="0.260" w="0.065" d="0.065" h="0.060"/>

      <!-- Используем gpu_lidar, но настраиваем его как 3D-датчик (многослойный) -->
      <sensor name="livox" type="gpu_lidar">
        <always_on>true</always_on>
        <visualize>false</visualize> <!-- false, чтобы 3D лучи не тормозили графику Gazebo -->
        <update_rate>5</update_rate> <!-- Стандартная частота Livox: 10 Гц -->
        <topic>/${robot_namespace}/livox</topic>   <!-- Публикует полноценное 3D облако точек -->
        <gz_frame_id>livox_link</gz_frame_id>
        <ray>
          <scan>
            <!-- Настройка горизонтального обзора (360 градусов) -->
            <horizontal>
              <samples>360</samples>
              <resolution>1.0</resolution>
              <min_angle>0.0</min_angle>
              <max_angle>6.28</max_angle>
            </horizontal>
            <!-- Настройка вертикального обзора (Livox Mid-360 имеет угол по вертикали ~59 градусов) -->
            <vertical>
              <samples>32</samples>     <!-- Количество вертикальных слоев лучей -->
              <resolution>1.0</resolution>
              <min_angle>-0.515</min_angle> <!-- ~ -29.5 градусов вниз -->
              <max_angle>0.515</max_angle>  <!-- ~ +29.5 градусов вверх -->
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>40.0</max> <!-- Максимальная дальность Livox Mid-360 на улице -->
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.02</stddev>
          </noise>
        </ray>
      </sensor>
    </link>

  </model>
</sdf>
